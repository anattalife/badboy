# Copy to .env for local development (the Codespaces setup script does this for you).

# Random secret for Payload sessions: openssl rand -hex 32
PAYLOAD_SECRET=

# Encrypts SSN, date of birth and income on credit applications: openssl rand -base64 32
# Losing this key makes stored applications unreadable. Keep a copy somewhere safe.
FIELD_ENCRYPTION_KEY=

# Cloudflare Turnstile spam protection. These are Cloudflare's public test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: sender shown on alert emails (production uses Cloudflare Email Sending).
# EMAIL_FROM_ADDRESS=leads@roanokemowers.com
# EMAIL_FROM_NAME=Roanoke Mowers website
