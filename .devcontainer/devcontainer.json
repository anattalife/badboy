{
  "name": "Roanoke Mowers",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Website",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "website": "pnpm dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/DEMO.md"]
    },
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
